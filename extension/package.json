{
  "name": "classradar_vscode",
  "displayName": "Class Radar",
  "version": "0.1.0",
  "private": true,
  "description": "Sends compile errors to the teacher's Class Radar board in erxes",
  "license": "MIT",
  "type": "commonjs",
  "main": "./dist/extension.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test src/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/vscode": "~1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "classradar.pickSeat",
        "title": "Class Radar: Суудал сонгох"
      },
      {
        "command": "classradar.showLog",
        "title": "Class Radar: Лог харах"
      }
    ],
    "configuration": {
      "title": "Class Radar",
      "properties": {
        "classradar.gatewayUrl": {
          "type": "string",
          "default": "http://localhost:4000/graphql",
          "description": "erxes gateway GraphQL endpoint"
        },
        "classradar.studentEmail": {
          "type": "string",
          "default": "demo.student@classradar.mn",
          "description": "Сурагчийн имэйл (demo-д mock)"
        },
        "classradar.classCode": {
          "type": "string",
          "default": "10A",
          "description": "Ангийн код"
        },
        "classradar.seat": {
          "type": "string",
          "default": "С12",
          "description": "Суудлын дугаар (жишээ нь С1, С12)"
        },
        "classradar.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Алдааг багшийн самбар руу илгээх эсэх"
        }
      }
    }
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Only reads diagnostics; never runs workspace code."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "engines": {
    "vscode": "^1.90.0"
  }
}
